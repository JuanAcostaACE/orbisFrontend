# Estilo comun para todos los editores (evita mezclar tabs/espacios y finales de linea)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[app.js]
# Generado por npm run build: no se edita a mano
insert_final_newline = false
